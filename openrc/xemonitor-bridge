#!/sbin/openrc-run
# XeMonitor serial-to-TCP bridge (Honeywell 1900 / CH340)
# OpenRC init script — instalado em /etc/init.d/xemonitor-bridge
# (Alpine WSL, CachyOS/OpenRC, etc.). O bridge é musl estático e já
# re-tenta o /dev/ttyUSB0 a cada 2s, então não há wait pelo device aqui.
#
# Sobrescreva em /etc/conf.d/xemonitor-bridge:
#   device="/dev/serial/by-id/usb-1a86_USB_Serial-if00-port0"

name="xemonitor-bridge"
description="XeMonitor serial-to-TCP bridge (Honeywell 1900 / CH340)"

command="/usr/local/bin/xemonitor-bridge"
command_background="yes"
command_user="root"
pidfile="/run/${RC_SVCNAME}.pid"
# command_opts é populado em start_pre() a partir de /etc/xemonitor/device
# (gravado pelo install.sh/install_windows.bat) ou /etc/conf.d/xemonitor-bridge (override manual).
# Fallback: auto-detecta CH340 via by-id -> udevadm -> /dev/ttyUSB0
# --http habilita modo híbrido TCP + HTTP/SSE (porta 9001) para histórico em tempo real
command_args="--http --device ${device:-/dev/ttyUSB0}"

depend() {
    # TCP server na porta 9000. No WSL a rede vem do host e o servico
    # 'net' pode nao existir (OpenRC nao e o init real no WSL/container),
    # entao nao usamos 'need net' — o bind em 0.0.0.0 funciona mesmo assim.
    after bootmisc
}

start_pre() {
    # 1. Config existente válida?
    if [ -f /etc/xemonitor/device ]; then
        . /etc/xemonitor/device
        if [ -n "${DEVICE:-}" ] && [ -e "${DEVICE}" ]; then
            command_args="--http --device ${DEVICE}"
            return 0
        fi
    fi

    # 2. Auto-detectar CH340 (múltiplas estratégias)
    dev=""

    # 2a. by-id persistente (udev) - preferido
    for d in /dev/serial/by-id/usb-1a86*; do
        if [ -e "$d" ]; then
            dev="$d"
            break
        fi
    done

    # 2b. Scan via udevadm (vendor 1a86 = CH340)
    if [ -z "$dev" ]; then
        for tty in /dev/ttyUSB*; do
            if [ -e "$tty" ]; then
                if udevadm info -a -n "$tty" 2>/dev/null | grep -q "1a86"; then
                    dev="$tty"
                    break
                fi
            fi
        done
    fi

    # 2c. Fallback padrão
    if [ -z "$dev" ] && [ -e /dev/ttyUSB0 ]; then
        dev="/dev/ttyUSB0"
    fi

    # 3. Usar device detectado
    if [ -n "$dev" ] && [ -e "$dev" ]; then
        command_args="--http --device $dev"
        # Persistir para próximas boots
        mkdir -p /etc/xemonitor
        echo "DEVICE=$dev" > /etc/xemonitor/device
        echo "device=$dev" > /etc/conf.d/xemonitor-bridge
    else
        command_args="--http --device /dev/ttyUSB0"  # último recurso
    fi
    return 0
}
